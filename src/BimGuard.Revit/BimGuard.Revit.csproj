<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RevitApiPath Condition="'$(RevitApiPath)' == '' and Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2026</RevitApiPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BimGuard.Wpf/BimGuard.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitApiPath)' == ''">
    <!-- Неофициальная упаковка оригинальных API DLL: только для компиляции, без поставки с плагином. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10" IncludeAssets="compile;build" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10" IncludeAssets="compile;build" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitApiPath)' != ''">
    <Reference Include="RevitAPI"><HintPath>$(RevitApiPath)/RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitApiPath)/RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
